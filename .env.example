# ============================================================
# LLM Provider 选择（dashscope / spark）
# ============================================================
# 切换方法：改 LLM_PROVIDER 即可。LLM 调用会走对应后端。
# ⚠️ 重要：Embedding 和 ASR 始终使用 DashScope，切到 Spark 后仍需保留 DASHSCOPE_API_KEY。
LLM_PROVIDER=spark

# --- DashScope (阿里云通义千问) — 保留用于 Embedding + ASR ---
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 讯飞星火 Spark (HTTP OpenAI 兼容) — 主 LLM ---
SPARK_API_KEY=你的APIpassword（从 console.xfyun.cn 获取，格式: key:secret）
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v2
SPARK_MODEL=spark-x

# --- 华为云盘古大模型（OpenAI 兼容接口）---
HUAWEI_API_KEY=
HUAWEI_BASE_URL=https://infer-api.ap-southeast-1.myhuaweicloud.com
HUAWEI_MODEL=pangu-nlp-n1-32k

# --- 华为云 IAM 认证 ---
HUAWEI_IAM_ENDPOINT=https://iam.ap-southeast-1.myhuaweicloud.com
HUAWEI_PROJECT_ID=
HUAWEI_AK=
HUAWEI_SK=

# --- 华为云 SIS 与 Embedding ---
HUAWEI_SIS_ENDPOINT=https://sis-ext.cn-north-4.myhuaweicloud.com
HUAWEI_SIS_PROJECT_ID=
HUAWEI_EMBEDDING_DEPLOYMENT_ID=
HUAWEI_EMBEDDING_MODEL=Pangu-EmbeddingRank-zh-2.0.3

# --- 美美区域视觉/多模态分析 ---
# huawei: 复用 HUAWEI_API_KEY/HUAWEI_BASE_URL/HUAWEI_MODEL 的 OpenAI 兼容多模态接口
# openai_compatible: 使用下面独立的 VISION_* 配置
# fallback: 不调用外部 API，只使用本地规则降级分析
VISION_PROVIDER=huawei
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Model Config
LLM_MODEL=qwen3-max
EMBEDDING_MODEL=text-embedding-v4

# DashScope ASR
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_MODEL=paraformer-v2
ASR_TIMEOUT=600
ASR_MODEL_LOCAL=paraformer-realtime-v2
ASR_INPUT_FORMAT=pcm

# App Config
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/lingxi.db

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Knowledge Graph
GRAPH_PERSIST_PATH=./data/graph.json

# Knowledge Extraction
EXTRACTION_MIN_CONFIDENCE=0.3
TREE_MIN_CONFIDENCE=0.4
EXTRACTION_SEGMENT_MERGE_SECONDS=30.0

# Lightweight ML Models
MODEL_ARTIFACT_DIR=./data/models
EVIDENCE_RANKER_MODEL_PATH=./data/models/evidence_ranker.json
ORGANIZER_CLASSIFIER_MODEL_PATH=./data/models/organizer_classifier.json
EVIDENCE_RANKER_ENABLED=true
ORGANIZER_CLASSIFIER_ENABLED=true
